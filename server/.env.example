# LP CLUB Conference — environment template
# Copy to server/.env. Never commit the real file.
PORT=8787
ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
DATA_DIR=../data

# Security / reverse proxy
TRUST_PROXY=false
ALLOW_ORIGIN=
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=8

# Feishu Base — optional until credentials are approved
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=B7EUbCcwiadz93sGX0xcpoDgnrh
FEISHU_TABLE_ID=tbl8lbo4hjnVHW9m

# LP CLUB outgoing email — optional until SMTP access is approved
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=LPCLUBGROUP@LP-club.cn
SMTP_PASS=
ORGANISER_EMAIL=LPCLUBGROUP@LP-club.cn

# One-time VIP codes (single persistent Node server, Node >=22)
# Local setup: npm run vip:init, then restart the server.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the encryption key stable and backed up separately from the database.
VIP_CODE_ENCRYPTION_KEY=
# Leave blank for local data/vip-codes.sqlite; production: /opt/lpclub/data/vip-codes.sqlite
VIP_DB_PATH=
