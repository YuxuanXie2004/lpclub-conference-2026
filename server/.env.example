# Copy to server/.env; never commit the real credentials.
PORT=8787
HOST=127.0.0.1
ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
TRUST_PROXY=false
ALLOW_ORIGIN=
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=8

# MySQL 8.0.17+ / InnoDB. db:init creates only this configured database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lpclub
MYSQL_PASSWORD=
MYSQL_DATABASE=lpclub_conference

# Email delivery is processed by the persistent Node service after registration commits.
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=LPCLUBGROUP@LP-club.cn
SMTP_PASS=
ORGANISER_EMAIL=LPCLUBGROUP@LP-club.cn
# Stable base64-encoded 32-byte keys. Generate each once and back up separately.
VIP_CODE_ENCRYPTION_KEY=
MAIL_PAYLOAD_KEY=

# Optional materials. No Feishu credentials or file scopes are used.
MATERIALS_ENABLED=false
# Include the deployment subpath, e.g. https://lp-club.cn/2026-pe-conference/
PUBLIC_BASE_URL=http://localhost:8787/
MATERIALS_SIGNING_KEY=
# Durable PRIVATE originals. Use an absolute path outside the web root in production.
MATERIALS_STORAGE_DIR=
# Disposable derivatives; never use the originals directory here.
MATERIALS_CACHE_DIR=
